# --- `delonix man` / o --help como manual (v0.48.0) ---

msgid "Manual pages in roff, generated from this binary — one per command."
msgstr "Páginas de manual em roff, geradas a partir deste binário — uma por comando."

msgid "Command to document (e.g. `container run`). With none, the top-level page."
msgstr "Comando a documentar (ex.: `container run`). Sem nenhum, a página de topo."

