msgstr "bridge '{}' não existe em /sys/class/net"

msgid "exec without a command"
msgstr "exec sem comando"

msgid "pod sandbox has no live netns"
msgstr "pod sandbox sem netns vivo"

msgid "delonix-cri: failed to allocate pty"
msgstr "delonix-cri: falha a alocar pty"

