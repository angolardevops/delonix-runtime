msgstr "{name}: limites de recursos actualizados (memory={memory}, cpus={cpus})"

msgid "no kind-mode cluster — create one with `delonix cluster create`"
msgstr "não há nenhum cluster em modo kind — cria um com `delonix cluster create`"

msgid "several clusters ({names}) — pick one with `--name`"
msgstr "há vários clusters ({names}) — escolhe um com `--name`"

msgid "cluster '{name}' has no running node — start it before loading images"
msgstr "o cluster '{name}' não tem nenhum nó a correr — arranca-o antes de carregar imagens"

