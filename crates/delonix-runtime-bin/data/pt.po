msgstr "'{name}' foi criado sem `-p` e sem `--net <rede>`, por isso o seu slirp não tem api-socket aberto — não há por onde publicar a quente. Publica pelo menos uma porta no `run`, ou usa `--net <rede>` (o ingress aceita publicações a quente sempre)."

msgid "(no containers running)"
msgstr "(nenhum container a correr)"

msgid "   ← native KVM: maximum-performance path available"
msgstr "   ← KVM nativo: caminho de máximo desempenho disponível"

msgid "no manifest: pass -f <file> or create a ./delonix-manifest.yaml"
msgstr "sem manifesto: passa -f <ficheiro> ou cria um ./delonix-manifest.yaml"

msgid "delonix: no route for this host/path"
msgstr "delonix: sem rota para este host/path"

