{
  "engineVersion": "3.1.0",
  "refused": [
    {
      "method": "POST",
      "path": "/containers/{id}/exec",
      "reason": "needs HTTP hijacking (a raw bidirectional stream over the upgraded connection); use `delonix container exec`"
    },
    {
      "method": "POST",
      "path": "/containers/{id}/attach",
      "reason": "same hijacking requirement, and this engine keeps no live stdin conduit to an already-started detached container"
    },
    {
      "method": "GET",
      "path": "/containers/{id}/logs",
      "reason": "not written yet; `delonix container logs` covers it"
    },
    {
      "method": "GET",
      "path": "/events",
      "reason": "not written yet; `delonix system events` covers it"
    },
    {
      "method": "POST",
      "path": "/build",
      "reason": "not written yet; `delonix build` covers it"
    },
    {
      "method": "GET|POST|DELETE",
      "path": "/networks",
      "reason": "not written yet; `delonix network` covers it"
    },
    {
      "method": "POST",
      "path": "/networks/create",
      "reason": "not written yet; `delonix network create` covers it"
    },
    {
      "method": "GET",
      "path": "/networks/{id}",
      "reason": "not written yet; `delonix network inspect` covers it"
    },
    {
      "method": "POST",
      "path": "/images/create",
      "reason": "not written yet — this is the pull, and most tools call it first; `delonix image pull` covers it from the CLI"
    },
    {
      "method": "GET",
      "path": "/images/{name}/json",
      "reason": "not written yet; `delonix image describe` covers it"
    },
    {
      "method": "GET",
      "path": "/containers/{id}/stats",
      "reason": "not written yet — it is a live metric stream, and this engine exposes those over Prometheus (`/metrics`) instead; `delonix dash` covers the interactive case"
    },
    {
      "method": "GET|POST|DELETE",
      "path": "/volumes",
      "reason": "not written yet; `delonix volume` covers it"
    }
  ],
  "served": [
