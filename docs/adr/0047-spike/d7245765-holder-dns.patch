+        assert_eq!(
+            route_host_answer(&i, "app.example.pt", Some([10, 200, 0, 7])),
+            Some([10, 200, 0, 1])
+        );
+    }
+
+    #[test]
+    fn the_name_is_case_and_trailing_dot_insensitive() {
+        let i = idx(&["app.example.pt"], &["10.210"]);
