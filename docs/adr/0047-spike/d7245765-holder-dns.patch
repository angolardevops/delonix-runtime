+
+    #[test]
+    fn a_client_gets_the_bridge_address_of_its_own_network() {
+        let i = idx(&["app.example.pt"], &["10.200.0.1/16", "10.210"]);
+        assert_eq!(
+            route_host_answer(&i, "app.example.pt", Some([10, 210, 3, 9])),
+            Some([10, 210, 0, 1])
