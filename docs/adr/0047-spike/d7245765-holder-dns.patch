+    use super::*;
+
+    fn idx(hosts: &[&str], nets: &[&str]) -> DnsIndex {
+        let mut i = DnsIndex::default();
+        i.route_hosts = hosts.iter().map(|h| h.to_string()).collect();
+        for n in nets {
+            let c = crate::Cidr::parse(n).unwrap();
+            i.gateways
+                .push((c.base, c.last(), parse_v4(&c.gateway().unwrap()).unwrap()));
