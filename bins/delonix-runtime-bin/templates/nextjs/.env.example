# Copy to .env.local for `pnpm dev` (Next.js loads it), or export the
# variables before `pnpm start`. Never commit a real .env file.
# Every variable is optional; the defaults below are what the code uses.
# None of these may get a NEXT_PUBLIC_ prefix: that would inline the value
# into the JavaScript sent to browsers.
APP_ENV=development
LOG_LEVEL=info
PORT=__PORT__
SHUTDOWN_TIMEOUT=15s
DRAIN_DELAY=0s
HTTP_MAX_BODY_BYTES=1048576

# Inbound webhooks (POST /api/v1/webhooks/inbound). Unset = endpoint answers 404.
# Generate: echo "whsec_$(head -c 32 /dev/urandom | base64)"
WEBHOOK_INBOUND_SECRET=
# Outbound webhooks: a signed `note.created` per new note. Unset = off.
WEBHOOK_TARGET_URL=
WEBHOOK_TARGET_SECRET=

# OpenTelemetry (standard variables). Unset endpoint = spans are recorded for
# log correlation but nothing is exported.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLER_ARG=1.0
