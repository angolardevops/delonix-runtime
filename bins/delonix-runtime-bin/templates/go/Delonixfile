# Delonixfile — same grammar as a Dockerfile. Build with:
#   delonix build -t __NAME__:dev .
#
# Two stages: the toolchain compiles a static binary, and only the binary
# reaches the runtime image (a few MB instead of the ~300 MB toolchain).
# go.mod and go.sum are copied first so the module download is cached until
# they change. The build context is filtered by .dockerignore.
FROM golang:__TEMPLATE_VERSION__-alpine AS build
ENV CGO_ENABLED=0 GOFLAGS=-trimpath
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
ARG VERSION=dev
RUN go build -ldflags "-s -w -X main.version=${VERSION}" -o /out/server ./cmd/__NAME__

FROM alpine:3.24
# CA roots for the outbound webhook over https, and an unprivileged user for
# the service. Nothing in the image belongs to that user: it writes nowhere
# but the manifest's tmpfs.
RUN apk add --no-cache ca-certificates \
    && addgroup -S -g 10001 app && adduser -S -D -H -u 10001 -G app app
COPY --from=build /out/server /usr/local/bin/server
EXPOSE __PORT__
# The runtime probes liveness; readiness is for the load balancer.
HEALTHCHECK CMD wget -qO- http://127.0.0.1:__PORT__/api/v1/health/live || exit 1
STOPSIGNAL SIGTERM
USER app
CMD ["/usr/local/bin/server"]
