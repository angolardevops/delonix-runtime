# Delonixfile — nginx __TEMPLATE_VERSION__: static site + reverse-proxy-ready edge.
# Build with:  delonix build -t __NAME__:dev .
FROM nginx:__TEMPLATE_VERSION__-alpine
COPY nginx.conf /etc/nginx/nginx.conf
COPY html /usr/share/nginx/html
# Syntax-check the config at build time — a typo fails the build, not the
# first request.
RUN nginx -t
EXPOSE __PORT__
# Delonix extension: the runtime probes this to mark the container healthy.
HEALTHCHECK CMD wget -qO- http://127.0.0.1:__PORT__/healthz || exit 1
CMD ["nginx", "-g", "daemon off;"]
