# Delonixfile — nginx __TEMPLATE_VERSION__: static site + reverse-proxy-ready edge, HTTPS on.
# Build with:  delonix build -t __NAME__:dev .
FROM nginx:__TEMPLATE_VERSION__-alpine
COPY nginx.conf /etc/nginx/nginx.conf
COPY html /usr/share/nginx/html
# Syntax-check the config at build time — a typo fails the build, not the
# first request. The certificate is mounted at run time and never enters the
# image, so the check runs on a copy with the two certificate lines removed and
# the TLS listener made plain; everything else is checked as written.
RUN mkdir -p /var/www/acme && \
    sed -e '/ssl_certificate/d' -e 's/ ssl backlog=/ backlog=/' /etc/nginx/nginx.conf > /tmp/check.conf && \
    nginx -t -c /tmp/check.conf && rm /tmp/check.conf
EXPOSE __PORT__ __TLS_PORT__
# Delonix extension: the runtime probes this to mark the container healthy.
HEALTHCHECK CMD wget -qO- http://127.0.0.1:__PORT__/healthz || exit 1
CMD ["nginx", "-g", "daemon off;"]
