# Generated by `delonix init` into `.env` — GIT-IGNORED, never commit it.
# The password below was generated locally, once; `delonix init` will not
# overwrite this file.
#
# These values wire compose.yaml's services together. ONE Postgres password is
# shared on purpose — it feeds the `db` service's POSTGRES_PASSWORD, Odoo's own
# PASSWORD (the official image's entrypoint passes HOST/USER/PASSWORD to the DB
# connection), and, under the `quality` profile, the sonar database too. This
# mirrors delonix-manifest.yaml, where a single Secret feeds both images.

# --- PostgreSQL (compose service `db`) + Odoo's DB login ---
# POSTGRES_* are read by the postgres image; USER/PASSWORD by the odoo image's
# entrypoint. POSTGRES_DB stays `postgres`: Odoo creates its own database on
# first start (see config/odoo.conf's db_name / dbfilter).
POSTGRES_USER=odoo
POSTGRES_PASSWORD=__SECRET_PGPASSWORD__
POSTGRES_DB=postgres
USER=odoo
PASSWORD=__SECRET_PGPASSWORD__

# --- SonarQube database (only the `quality` profile uses these) ---
# sonar-db's POSTGRES_USER / POSTGRES_DB are pinned to `sonar` in compose.yaml;
# its POSTGRES_PASSWORD is the shared secret above, so SONAR_JDBC_PASSWORD must
# match it.
SONAR_JDBC_URL=jdbc:postgresql://sonar-db:5432/sonar
SONAR_JDBC_USERNAME=sonar
SONAR_JDBC_PASSWORD=__SECRET_PGPASSWORD__
