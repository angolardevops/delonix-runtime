# Copy to .env for local runs (`set -a; . ./.env; set +a`). Never commit .env.
# Every variable is optional outside production; the defaults below are what
# the code uses. Production (APP_ENV=production) REQUIRES SECRET_KEY (or
# SECRET_KEY_FILE), ALLOWED_HOSTS and DATABASE_URL.
APP_ENV=development            # development | test | production
LOG_LEVEL=info                 # debug | info | warning | error
PORT=__PORT__
HTTP_HOST=0.0.0.0
WEB_CONCURRENCY=2              # gunicorn worker processes
GUNICORN_THREADS=4             # threads per worker
SHUTDOWN_TIMEOUT=15s
DRAIN_DELAY=0s                 # e.g. 5s behind a load balancer
HTTP_MAX_BODY_BYTES=1048576

# Django. Generate a key: python3 -c 'import secrets; print(secrets.token_urlsafe(50))'
SECRET_KEY=
# Alternative to SECRET_KEY: a file holding the key, created with a random key
# on first use (mode 0600). Put it on a persistent volume.
SECRET_KEY_FILE=
ALLOWED_HOSTS=                 # comma-separated; development default: localhost,127.0.0.1,[::1]
DATABASE_URL=                  # development default: sqlite:///<project>/db.sqlite3
                               # postgres://user:password@host:5432/name  (needs: uv add 'psycopg[binary]')

# Transport security (production defaults in parentheses).
TRUSTED_PROXY=                 # address(es) of the TLS-terminating proxy; enables X-Forwarded-Proto
SECURE_SSL_REDIRECT=           # (true) redirect plain HTTP to https
SECURE_HSTS_SECONDS=           # (31536000)
SECURE_HSTS_INCLUDE_SUBDOMAINS= # (true)
SECURE_HSTS_PRELOAD=           # (false)

# Inbound webhooks (POST /api/v1/webhooks/inbound). Unset = endpoint answers 404.
# Generate: echo "whsec_$(head -c 32 /dev/urandom | base64)"
WEBHOOK_INBOUND_SECRET=
# Outbound webhooks: a signed `note.created` per new note. Unset = off.
WEBHOOK_TARGET_URL=
WEBHOOK_TARGET_SECRET=

# OpenTelemetry (standard variables). Unset endpoint = spans are recorded for
# log correlation but nothing is exported.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
