# Generated by `delonix init` into `.env` — GIT-IGNORED, never commit it.
# The passwords below were generated locally, once; `delonix init` will not
# overwrite this file (delete it to regenerate the secrets).
#
# These values wire WordPress to the `compose.yaml` services (hostname `db`
# for MariaDB, `sonar-db` for the quality profile).

# --- MariaDB (compose service `db`) ---
# ONE password, reused on purpose: the MariaDB image creates the user with it
# (MYSQL_PASSWORD) and WordPress connects with the SAME value
# (WORDPRESS_DB_PASSWORD) below. MYSQL_ROOT_PASSWORD shares it too — fine for a
# laptop; split it before a real deployment.
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=__SECRET_DBPASS__
MYSQL_ROOT_PASSWORD=__SECRET_DBPASS__

# --- WordPress (compose service `__NAME__`). The password matches MariaDB's
# above, by design — the same credential on both sides of the connection. ---
WORDPRESS_DB_HOST=db:3306
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=__SECRET_DBPASS__
WORDPRESS_DB_NAME=wordpress

# --- SonarQube database (only the `quality` profile uses these) ---
POSTGRES_USER=sonar
POSTGRES_PASSWORD=__SECRET_SONARDB__
POSTGRES_DB=sonar
SONAR_JDBC_URL=jdbc:postgresql://sonar-db:5432/sonar
SONAR_JDBC_USERNAME=sonar
SONAR_JDBC_PASSWORD=__SECRET_SONARDB__
