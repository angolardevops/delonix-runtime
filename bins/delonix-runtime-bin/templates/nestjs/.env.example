# Copy to .env for local runs (`set -a; . ./.env; set +a`). Never commit .env.
# Every variable is optional; the defaults below are what the code uses.
APP_ENV=development            # development | test | production
LOG_LEVEL=info                 # debug | info | warn | error
PORT=__PORT__
HTTP_HOST=0.0.0.0
SHUTDOWN_TIMEOUT=15s           # durations: 500ms, 15s, 1m
DRAIN_DELAY=0s                 # e.g. 5s behind a load balancer
HTTP_MAX_BODY_BYTES=1048576

# Redis read-through cache (compose service `redis`). Unset = in-process cache.
REDIS_URL=
CACHE_TTL=300s                 # cache-aside entry lifetime (durations: 15s, 5m)

# RabbitMQ for `note.created` (compose service `rabbitmq`). Unset = messaging off.
# `delonix init` fills the compose stack's values into .env; this file only
# documents them. amqp:// or amqps://.
RABBITMQ_URL=

# Inbound webhooks (POST /api/v1/webhooks/inbound). Unset = endpoint off.
# Generate: echo "whsec_$(head -c 32 /dev/urandom | base64)"
WEBHOOK_INBOUND_SECRET=
# Outbound webhooks: a signed `note.created` per new note. Unset = off.
WEBHOOK_TARGET_URL=
WEBHOOK_TARGET_SECRET=

# OpenTelemetry (standard variables). Unset endpoint = spans are recorded for
# log correlation but nothing is exported.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
