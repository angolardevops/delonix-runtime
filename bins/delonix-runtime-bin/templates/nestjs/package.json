{
  "name": "__NAME__",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS __TEMPLATE_VERSION__ service generated by delonix init -t nestjs",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.28.2",
  "engines": {
    "node": ">=24.9"
  },
  "scripts": {
    "build": "nest build",
    "start": "node --require ./dist/instrumentation.js dist/main.js",
    "start:dev": "nest start --watch --exec \"node --require ./dist/instrumentation.js\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "jest": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js",
    "test": "pnpm run jest",
    "test:unit": "pnpm run jest --selectProjects unit",
    "test:e2e": "pnpm run jest --selectProjects e2e",
    "test:cov": "pnpm run jest --coverage",
    "openapi:write": "UPDATE_OPENAPI=1 pnpm run jest --selectProjects e2e --testPathPatterns openapi",
    "smoke": "sh ./scripts/smoke.sh",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@nestjs/common": "^__TEMPLATE_VERSION__",
    "@nestjs/core": "^__TEMPLATE_VERSION__",
    "@nestjs/platform-express": "^__TEMPLATE_VERSION__",
    "@nestjs/swagger": "^__TEMPLATE_VERSION__",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.11.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/instrumentation-http": "^0.222.0",
    "@opentelemetry/instrumentation-undici": "^0.32.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^__TEMPLATE_VERSION__",
    "@nestjs/testing": "^__TEMPLATE_VERSION__",
    "@opentelemetry/context-async-hooks": "^2.11.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.11.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.9",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.14",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.0"
  },
  "jest": {
    "projects": [
      {
        "displayName": "unit",
        "testEnvironment": "node",
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
          "^.+\\.ts$": [
            "ts-jest",
            {
              "tsconfig": "<rootDir>/../tsconfig.json"
            }
          ]
        }
      },
      {
        "displayName": "e2e",
        "testEnvironment": "node",
        "rootDir": "test",
        "testRegex": ".*\\.e2e-spec\\.ts$",
        "transform": {
          "^.+\\.ts$": [
            "ts-jest",
            {
              "tsconfig": "<rootDir>/../tsconfig.json"
            }
          ]
        }
      }
    ]
  }
}
