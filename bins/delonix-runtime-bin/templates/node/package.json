{
  "name": "__NAME__",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --import ./src/instrumentation.ts src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --import ./dist/instrumentation.js dist/index.js",
    "format": "prettier --write src test scripts eslint.config.js",
    "format:check": "prettier --check src test scripts eslint.config.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "openapi:write": "tsx scripts/write-openapi.ts",
    "smoke": "sh scripts/smoke.sh",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@fastify/swagger": "^9.9.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/instrumentation-http": "0.222.0",
    "@opentelemetry/instrumentation-undici": "0.32.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-metrics": "2.11.0",
    "@opentelemetry/sdk-node": "0.222.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "fastify": "^__TEMPLATE_VERSION__",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
