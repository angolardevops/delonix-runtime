# Generated by `delonix init` into `.env` — GIT-IGNORED, never commit it.
# The passwords below were generated locally, once; `delonix init` will not
# overwrite this file. `.env.example` documents what every variable means.
#
# These values wire the app to the `compose.yaml` services (hostnames `redis`,
# `rabbitmq`, `sonar-db`). For a bare `node` / `pnpm dev` run WITHOUT compose,
# comment out REDIS_URL and RABBITMQ_URL to use the in-process cache and switch
# messaging off.
APP_ENV=development
LOG_LEVEL=info
SERVICE_NAME=__NAME__
PORT=__PORT__

# --- Redis cache (compose service `redis`) ---
REDIS_URL=redis://redis:6379/0
CACHE_TTL=300s

# --- RabbitMQ (compose service `rabbitmq`). The password appears twice on
# purpose: once for the broker to create the user, once in the app's URL. ---
RABBITMQ_DEFAULT_USER=app
RABBITMQ_DEFAULT_PASS=__SECRET_RABBITMQ__
RABBITMQ_URL=amqp://app:__SECRET_RABBITMQ__@rabbitmq:5672/

# --- SonarQube database (only the `quality` profile uses these) ---
POSTGRES_USER=sonar
POSTGRES_PASSWORD=__SECRET_SONARDB__
POSTGRES_DB=sonar
SONAR_JDBC_URL=jdbc:postgresql://sonar-db:5432/sonar
SONAR_JDBC_USERNAME=sonar
SONAR_JDBC_PASSWORD=__SECRET_SONARDB__

# --- Webhooks (optional; unset = off). See .env.example for how to fill. ---
WEBHOOK_INBOUND_SECRET=
WEBHOOK_TARGET_URL=
WEBHOOK_TARGET_SECRET=
