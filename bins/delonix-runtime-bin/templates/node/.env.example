# Copy to .env for local runs (`set -a; . ./.env; set +a`). Never commit .env.
# Every variable is optional; the defaults below are what the code uses.
APP_ENV=development            # development | test | production
LOG_LEVEL=info                 # debug | info | warn | error
PORT=__PORT__
HTTP_HOST=0.0.0.0
SHUTDOWN_TIMEOUT=15s
DRAIN_DELAY=0s                 # e.g. 5s behind a load balancer
HTTP_MAX_BODY_BYTES=1048576

# Inbound webhooks (POST /api/v1/webhooks/inbound). Unset = endpoint off.
# Generate: echo "whsec_$(head -c 32 /dev/urandom | base64)"
WEBHOOK_INBOUND_SECRET=
# Outbound webhooks: a signed `note.created` per new note. Unset = off.
WEBHOOK_TARGET_URL=
WEBHOOK_TARGET_SECRET=

# Redis cache (read-through for note lookups). Unset = an in-process cache, so
# local runs need no Redis. compose.yaml sets this to the redis service. The
# URL carries the password; it is never logged.
REDIS_URL=
CACHE_TTL=300s

# RabbitMQ async messaging (publish + consume note.created). Unset = off.
# compose.yaml sets this to the rabbitmq service. Password in the URL, never
# logged. See src/messaging/ for the exchange/queue/dead-letter setup.
RABBITMQ_URL=

# OpenTelemetry (standard variables). Unset endpoint = spans are recorded for
# log correlation but nothing is exported.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0

# --- Variables the compose.yaml services read (not the app). `delonix init`
# writes real random secrets for these into the generated .env; they are shown
# here only for reference and are NOT used by a bare `node` run. ---
# RabbitMQ broker bootstrap (compose service `rabbitmq`):
#   RABBITMQ_DEFAULT_USER=app
#   RABBITMQ_DEFAULT_PASS=<generated>        # also inside RABBITMQ_URL above
# SonarQube database (compose `quality` profile):
#   POSTGRES_USER=sonar
#   POSTGRES_PASSWORD=<generated>
#   POSTGRES_DB=sonar
#   SONAR_JDBC_URL=jdbc:postgresql://sonar-db:5432/sonar
#   SONAR_JDBC_USERNAME=sonar
#   SONAR_JDBC_PASSWORD=<generated>          # matches POSTGRES_PASSWORD
