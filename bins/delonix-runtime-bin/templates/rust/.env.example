# Copy to .env for local runs (read at startup; never commit .env).
# Every variable is optional; the values below are the defaults the code uses.
# An empty value means "not set". Durations accept 15, 15s, 500ms or 1m.
APP_ENV=development            # development | test | production
LOG_LEVEL=info                 # debug | info | warn | error
SERVICE_NAME=__NAME__
PORT=__PORT__
HTTP_HOST=0.0.0.0
HTTP_MAX_BODY_BYTES=1048576
SHUTDOWN_TIMEOUT=15s
DRAIN_DELAY=0s                 # e.g. 5s behind a load balancer

# Inbound webhooks (POST /api/v1/webhooks/inbound). Unset = endpoint answers 404.
# Generate: echo "whsec_$(head -c 32 /dev/urandom | base64)"
WEBHOOK_INBOUND_SECRET=
# Outbound webhooks: a signed `note.created` per new note. Unset = off.
WEBHOOK_TARGET_URL=
WEBHOOK_TARGET_SECRET=

# Redis cache (read-through for note lookups). Unset = an in-process cache, so
# local runs need no Redis. compose.yaml sets this to the redis service. The
# URL carries the password; it is never logged.
REDIS_URL=
CACHE_TTL=300s

# RabbitMQ async messaging (publish + consume note.created). Unset = off.
# compose.yaml sets this to the rabbitmq service. The broker glue is behind the
# `amqp` cargo feature; build with `--features amqp` to publish for real.
RABBITMQ_URL=

# OpenTelemetry (standard variables, read from the process environment, not from
# this file — export them or pass them to the container). Unset endpoint = spans
# are recorded in-process for log correlation, nothing is exported.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=1.0

# --- Variables the compose.yaml services read (not the app). `delonix init`
# writes real random secrets for these into the generated .env; they are shown
# here only for reference. ---
# RabbitMQ broker bootstrap (compose service `rabbitmq`):
#   RABBITMQ_DEFAULT_USER=app
#   RABBITMQ_DEFAULT_PASS=<generated>        # also inside RABBITMQ_URL above
# SonarQube database (compose `quality` profile):
#   POSTGRES_USER=sonar
#   POSTGRES_PASSWORD=<generated>
#   POSTGRES_DB=sonar
#   SONAR_JDBC_URL=jdbc:postgresql://sonar-db:5432/sonar
#   SONAR_JDBC_USERNAME=sonar
#   SONAR_JDBC_PASSWORD=<generated>          # matches POSTGRES_PASSWORD
