{
    "name": "app/__NAME__",
    "type": "project",
    "description": "__NAME__ — a Laravel __TEMPLATE_VERSION__ service generated by `delonix init -t laravel`.",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "guzzlehttp/guzzle": "^7.9",
        "laravel/framework": "^__TEMPLATE_VERSION__",
        "open-telemetry/api": "^1.10",
        "open-telemetry/exporter-otlp": "^1.4",
        "open-telemetry/sdk": "^1.15"
    },
    "require-dev": {
        "larastan/larastan": "^3.12",
        "laravel/pint": "^1.32",
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Migrations\\": "database/migrations/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php artisan package:discover --ansi"
        ],
        "lock-check": "@php -r \"if (!is_file('composer.lock')) { fwrite(STDERR, 'composer.lock is missing: run composer install once and commit composer.lock (see README, Quickstart).'.PHP_EOL); exit(1); }\"",
        "format": "pint",
        "format-check": "pint --test",
        "lint": "@php scripts/lint.php",
        "analyse": "phpstan analyse --no-progress --memory-limit=512M",
        "test": "phpunit",
        "check": [
            "@lock-check",
            "@format-check",
            "@lint",
            "@analyse",
            "@test"
        ],
        "audit-deps": "@composer audit --locked",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan app:check-config",
            "@php artisan migrate --force",
            "@php artisan serve --host=0.0.0.0 --port=__PORT__"
        ],
        "smoke": "sh scripts/smoke.sh"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.4.1"
        },
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
