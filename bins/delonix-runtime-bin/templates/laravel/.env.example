# Copy to .env for local runs (`cp .env.example .env`). Never commit .env.
# Values below are what the code uses when a variable is unset.
APP_ENV=development            # development | test | production
APP_DEBUG=false                # never true in production (refused at startup)
# Required in production; generate with: php artisan key:generate --show
APP_KEY=
LOG_LEVEL=info                 # debug | info | notice | warning | error
LOG_CHANNEL=json
PORT=__PORT__
HTTP_MAX_BODY_BYTES=1048576
SHUTDOWN_TIMEOUT=15s           # FrankenPHP grace period for in-flight requests
DRAIN_DELAY=0s                 # e.g. 5s behind a load balancer

# SQLite by default: database/database.sqlite (created by `composer serve`).
DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/database.sqlite

# Cache store. array = in-process (no Redis, the default for a bare run).
# redis = read-through Redis; set REDIS_URL. compose.yaml sets CACHE_STORE=redis.
CACHE_STORE=array
CACHE_TTL=300s
# Redis connection (read by config/database.php). Unset = no Redis needed.
REDIS_URL=

# Queue. database = jobs table, no broker (the default). rabbitmq = the broker
# (set the RABBITMQ_* vars below). Either way run `php artisan queue:work`.
QUEUE_CONNECTION=database
# RabbitMQ (compose service `rabbitmq`). Used only when QUEUE_CONNECTION=rabbitmq.
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Inbound webhooks (POST /api/v1/webhooks/inbound). Unset = endpoint off (404).
# Generate: echo "whsec_$(head -c 32 /dev/urandom | base64)"
WEBHOOK_INBOUND_SECRET=
# Outbound webhooks: a signed `note.created` per new note. Unset = off.
WEBHOOK_TARGET_URL=
WEBHOOK_TARGET_SECRET=

# OpenTelemetry (standard variables). Unset endpoint = spans are recorded for
# log correlation but nothing is exported.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_TIMEOUT=2000
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_TRACES_SAMPLER_ARG=1.0

# --- Variables the compose.yaml services read (not the app). `delonix init`
# writes real random secrets for these into the generated .env; they are shown
# here only for reference. ---
# RabbitMQ broker bootstrap (compose service `rabbitmq`):
#   RABBITMQ_DEFAULT_USER=app
#   RABBITMQ_DEFAULT_PASS=<generated>        # also RABBITMQ_PASSWORD above
# SonarQube database (compose `quality` profile):
#   POSTGRES_USER=sonar
#   POSTGRES_PASSWORD=<generated>
#   POSTGRES_DB=sonar
#   SONAR_JDBC_URL=jdbc:postgresql://sonar-db:5432/sonar
#   SONAR_JDBC_USERNAME=sonar
#   SONAR_JDBC_PASSWORD=<generated>          # matches POSTGRES_PASSWORD
