# Copy to .env for local runs (`cp .env.example .env`). Never commit .env.
# Values below are what the code uses when a variable is unset.
APP_ENV=development            # development | test | production
APP_DEBUG=false                # never true in production (refused at startup)
# Required in production; generate with: php artisan key:generate --show
APP_KEY=
LOG_LEVEL=info                 # debug | info | notice | warning | error
LOG_CHANNEL=json
PORT=__PORT__
HTTP_MAX_BODY_BYTES=1048576
SHUTDOWN_TIMEOUT=15s           # FrankenPHP grace period for in-flight requests
DRAIN_DELAY=0s                 # e.g. 5s behind a load balancer

# SQLite by default: database/database.sqlite (created by `composer serve`).
DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/database.sqlite
QUEUE_CONNECTION=database      # outbound webhooks: run `php artisan queue:work`

# Inbound webhooks (POST /api/v1/webhooks/inbound). Unset = endpoint off (404).
# Generate: echo "whsec_$(head -c 32 /dev/urandom | base64)"
WEBHOOK_INBOUND_SECRET=
# Outbound webhooks: a signed `note.created` per new note. Unset = off.
WEBHOOK_TARGET_URL=
WEBHOOK_TARGET_SECRET=

# OpenTelemetry (standard variables). Unset endpoint = spans are recorded for
# log correlation but nothing is exported.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_TIMEOUT=2000
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_TRACES_SAMPLER_ARG=1.0
