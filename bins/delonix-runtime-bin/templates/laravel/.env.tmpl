# Generated by `delonix init` into `.env` — GIT-IGNORED, never commit it.
# The APP_KEY and passwords below were generated locally, once; `delonix init`
# will not overwrite this file. `.env.example` documents what every variable
# means.
#
# These values wire the app to the `compose.yaml` services (hostnames `redis`,
# `rabbitmq`, `sonar-db`). For a bare `composer serve` run WITHOUT compose,
# leave CACHE_STORE=array and QUEUE_CONNECTION=database (the defaults below) so
# the service needs neither Redis nor RabbitMQ.
APP_ENV=development
APP_DEBUG=false
# Laravel application key (base64: + 32 random bytes). Required in production.
APP_KEY=base64:{random32}
LOG_LEVEL=info
LOG_CHANNEL=json
SERVICE_NAME=__NAME__
PORT=__PORT__

# SQLite by default; compose mounts a volume at /var/lib/app.
DB_CONNECTION=sqlite

# --- Redis cache (compose service `redis`). CACHE_STORE=redis reads through
# Redis; leave it `array` for an in-process cache with no Redis. ---
CACHE_STORE=redis
REDIS_URL=redis://redis:6379/0
CACHE_TTL=300s

# --- RabbitMQ queue (compose service `rabbitmq`). QUEUE_CONNECTION=rabbitmq
# runs the outbound-webhook jobs through the broker; `database` keeps them in
# the jobs table instead. The password appears on the broker bootstrap vars
# and in the app's connection on purpose: once to create the user, once to
# connect. ---
QUEUE_CONNECTION=rabbitmq
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/
RABBITMQ_USER=app
RABBITMQ_PASSWORD=__SECRET_RABBITMQ__
RABBITMQ_DEFAULT_USER=app
RABBITMQ_DEFAULT_PASS=__SECRET_RABBITMQ__

# --- SonarQube database (only the `quality` profile uses these) ---
POSTGRES_USER=sonar
POSTGRES_PASSWORD=__SECRET_SONARDB__
POSTGRES_DB=sonar
SONAR_JDBC_URL=jdbc:postgresql://sonar-db:5432/sonar
SONAR_JDBC_USERNAME=sonar
SONAR_JDBC_PASSWORD=__SECRET_SONARDB__

# --- Webhooks (optional; unset = off). See .env.example for how to fill. ---
WEBHOOK_INBOUND_SECRET=
WEBHOOK_TARGET_URL=
WEBHOOK_TARGET_SECRET=
