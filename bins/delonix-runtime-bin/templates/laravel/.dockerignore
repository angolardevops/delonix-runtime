# Honoured by `delonix build` and `docker build` alike: nothing listed here
# reaches the image.
.git
.github
.gitlab-ci.yml
.env
.env.*
!.env.example
/vendor
/node_modules
/database/*.sqlite
/database/*.sqlite-*
/storage/logs/*.log
/storage/framework/cache/data
/storage/framework/sessions/*
/storage/framework/views/*.php
/bootstrap/cache/*.php
/tests
/docs
*.md
/coverage
/.phpunit.cache
/.phpunit.result.cache
/phpstan.neon
/pint.json
/phpunit.xml
/deploy
