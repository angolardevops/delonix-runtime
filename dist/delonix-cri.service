[Unit]
Description=Delonix CRI (runtime.v1) — endpoint local para o kubelet
Documentation=https://github.com/angolardevops/delonix-runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=/bin/mkdir -p /var/lib/delonix
Environment=DELONIX_ROOT=/var/lib/delonix
Environment=DELONIX_CRI_ADDR=unix:///run/delonix-cri.sock
# Tecto de capabilities do nó — limite MÁXIMO das capabilities de qualquer
# container criado por este CRI, seja o que for que o kubelet pedir (inclui
# `privileged: true`). Sem estas linhas não há tecto, que é o comportamento
# histórico. Um valor mal escrito impede o serviço de arrancar, de propósito:
# um tecto que caísse em silêncio para "ilimitado" seria pior que nenhum.
#   Environment=DELONIX_CRI_CAP_CEILING=default,NET_ADMIN
#   Environment=DELONIX_CRI_CAP_CEILING_MODE=reject
ExecStart=/usr/local/bin/delonix-cri
Restart=always
RestartSec=2
LimitNOFILE=1048576

# Reiniciar o CRI NÃO pode matar os containers que ele lançou.
#
# Sem estas duas linhas o `KillMode` é o `control-group` por omissão: os
# containers são netos deste serviço e vivem no seu cgroup, logo qualquer
# reinício (e há `Restart=always`) leva um SIGTERM a TODOS ao mesmo tempo. Num
# nó Kubernetes isso é o control-plane inteiro a cair de uma vez.
#
# Medido a 2026-08-16/17 numa golden 1.36: os quatro static pods
# (etcd/apiserver/controller-manager/scheduler) saíam com `Exited (0)` — saída
# LIMPA, não crash — os quatro no mesmo instante, sem uma única falha de sonda
# no kubelet, e o `kubeadm init` ficava preso em `wait-control-plane`. O mesmo
# container lançado à mão pelo CLI ficava `Up`, porque aí não há cgroup de
# serviço a matá-lo.
#
# `Delegate=yes` dá ao CRI o seu próprio subárvore de cgroup para gerir, e
# `KillMode=process` faz o systemd parar só o processo principal. É exactamente
# o que a unit do containerd faz, e pela mesma razão.
Delegate=yes
KillMode=process

[Install]
WantedBy=multi-user.target
